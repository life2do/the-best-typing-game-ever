  "layout": {
    "Backquote": {
      "char": "ё",
      "shift": "Ё",
      "finger": "lp",
      "row": "number",
      "col": 0
    },
    "Digit1": {
      "char": "1",
      "shift": "!",
      "finger": "lp",
      "row": "number",
      "col": 1
    },
    "Digit2": {
      "char": "2",
      "shift": "\"",
      "finger": "lr",
      "row": "number",
      "col": 2
    },
    "Digit3": {
      "char": "3",
      "shift": "№",
      "finger": "lm",
      "row": "number",
      "col": 3
    },
    "Digit4": {
      "char": "4",
      "shift": ";",
      "finger": "li",
      "row": "number",
      "col": 4
    },
    "Digit5": {
      "char": "5",
      "shift": "%",
      "finger": "li",
      "row": "number",
      "col": 5
    },
    "Digit6": {
      "char": "6",
      "shift": ":",
      "finger": "ri",
      "row": "number",
      "col": 6
    },
    "Digit7": {
      "char": "7",
      "shift": "?",
      "finger": "ri",
      "row": "number",
      "col": 7
    },
    "Digit8": {
      "char": "8",
      "shift": "*",
      "finger": "rm",
      "row": "number",
      "col": 8
    },
    "Digit9": {
      "char": "9",
      "shift": "(",
      "finger": "rr",
      "row": "number",
      "col": 9
    },
    "Digit0": {
      "char": "0",
      "shift": ")",
      "finger": "rp",
      "row": "number",
      "col": 10
    },
    "Minus": {
      "char": "-",
      "shift": "_",
      "finger": "rp",
      "row": "number",
      "col": 11
    },
    "Equal": {
      "char": "=",
      "shift": "+",
      "finger": "rp",
      "row": "number",
      "col": 12
    },
    "KeyQ": {
      "char": "й",
      "shift": "Й",
      "finger": "lp",
      "row": "top",
      "col": 0
    },
    "KeyW": {
      "char": "ц",
