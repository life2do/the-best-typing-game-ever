{
  "id": "lang.ru",
  "kind": "language-pack",
  "version": 1,
  "description": "Russian ЙЦУКЕН language pack: physical key map with fingers, home-row-first key order, curated kid-friendly words and a blocklist.",
  "prompt": "PROMPT.md",
  "license": "CC0-1.0",
  "authors": [
    "agent:claude"
  ],
  "name": {
    "en": "Russian",
    "ru": "Русский"
  },
  "script": "cyrillic",
  "alphabet": [
    "а",
    "б",
    "в",
    "г",
    "д",
    "е",
    "ё",
    "ж",
    "з",
    "и",
    "й",
