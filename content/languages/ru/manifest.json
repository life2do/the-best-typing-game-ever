    "KeyM": {
      "char": "ь",
      "shift": "Ь",
      "finger": "ri",
      "row": "bottom",
      "col": 6
    },
    "Comma": {
      "char": "б",
      "shift": "Б",
      "finger": "rm",
      "row": "bottom",
      "col": 7
    },
    "Period": {
      "char": "ю",
      "shift": "Ю",
      "finger": "rr",
      "row": "bottom",
      "col": 8
    },
    "Slash": {
      "char": ".",
      "shift": ",",
      "finger": "rp",
      "row": "bottom",
      "col": 9
    },
    "Space": {
      "char": " ",
      "finger": "rt",
      "row": "space",
      "col": 0
    },
    "Backspace": {
      "char": "\b",
      "finger": "rp",
      "row": "number",
      "col": 99
    },
    "Enter": {
      "char": "\n",
      "finger": "rp",
      "row": "home",
      "col": 99
    },
    "Tab": {
      "char": "\t",
      "finger": "lp",
      "row": "top",
      "col": -1
