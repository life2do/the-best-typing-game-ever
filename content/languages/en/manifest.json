{
  "id": "lang.en",
  "kind": "language-pack",
  "version": 1,
  "description": "English, US QWERTY. Classic home-row-first order adjusted so useful words appear early (E and Space early).",
  "prompt": "PROMPT.md",
  "license": "CC0-1.0",
  "authors": [
    "agent:claude"
  ],
  "name": {
    "en": "English",
    "ru": "Английский"
  },
  "script": "latin",
  "alphabet": [
    "a",
    "b",
    "c",
    "d",
    "e",
    "f",
    "g",
    "h",
    "i",
    "j",
