    "KeyD": {
      "char": "d",
      "shift": "D",
      "finger": "lm",
      "row": "home",
      "col": 2
    },
    "KeyF": {
      "char": "f",
      "shift": "F",
      "finger": "li",
      "row": "home",
      "col": 3,
      "homeBump": true
    },
    "KeyG": {
      "char": "g",
      "shift": "G",
      "finger": "li",
      "row": "home",
      "col": 4
    },
    "KeyH": {
      "char": "h",
      "shift": "H",
      "finger": "ri",
      "row": "home",
      "col": 5
    },
    "KeyJ": {
      "char": "j",
      "shift": "J",
      "finger": "ri",
      "row": "home",
      "col": 6,
      "homeBump": true
    },
    "KeyK": {
      "char": "k",
      "shift": "K",
      "finger": "rm",
      "row": "home",
      "col": 7
    },
    "KeyL": {
      "char": "l",
      "shift": "L",
      "finger": "rr",
      "row": "home",
      "col": 8
    },
    "Semicolon": {
      "char": ";",
      "shift": ":",
      "finger": "rp",
      "row": "home",
      "col": 9
    },
    "Quote": {
      "char": "'",
      "shift": "\"",
      "finger": "rp",
      "row": "home",
      "col": 10
    },
    "KeyZ": {
      "char": "z",
      "shift": "Z",
      "finger": "lp",
      "row": "bottom",
      "col": 0
    },
    "KeyX": {
      "char": "x",
      "shift": "X",
      "finger": "lr",
      "row": "bottom",
      "col": 1
    },
    "KeyC": {
      "char": "c",
      "shift": "C",
      "finger": "lm",
      "row": "bottom",
      "col": 2
    },
    "KeyV": {
      "char": "v",
      "shift": "V",
      "finger": "li",
      "row": "bottom",
      "col": 3
    },
    "KeyB": {
      "char": "b",
      "shift": "B",
      "finger": "li",
      "row": "bottom",
      "col": 4
    },
    "KeyN": {
      "char": "n",
      "shift": "N",
      "finger": "ri",
      "row": "bottom",
      "col": 5
    },
    "KeyM": {
      "char": "m",
      "shift": "M",
      "finger": "ri",
      "row": "bottom",
      "col": 6
    },
    "Comma": {
      "char": ",",
      "shift": "<",
      "finger": "rm",
      "row": "bottom",
      "col": 7
    },
    "Period": {
      "char": ".",
      "shift": ">",
      "finger": "rr",
      "row": "bottom",
      "col": 8
    },
    "Slash": {
      "char": "/",
      "shift": "?",
      "finger": "rp",
      "row": "bottom",
      "col": 9
    },
    "Space": {
      "char": " ",
      "finger": "rt",
      "row": "space",
      "col": 0
    },
    "Backspace": {
      "char": "\b",
      "finger": "rp",
      "row": "number",
      "col": 99
    },
    "Enter": {
      "char": "\n",
      "finger": "rp",
      "row": "home",
      "col": 99
    },
    "Tab": {
      "char": "\t",
      "finger": "lp",
      "row": "top",
      "col": 99
    }
