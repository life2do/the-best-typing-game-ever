{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life2do.github.io/the-best-typing-game-ever/schemas/language-pack.schema.json",
  "title": "Language pack",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/itemBase"
    }
  ],
  "type": "object",
  "properties": {
    "kind": {
      "const": "language-pack"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "script": {
      "enum": [
        "latin",
        "cyrillic",
        "other"
      ]
    },
    "alphabet": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "layout": {
      "type": "object",
      "description": "KeyboardEvent.code -> key info",
      "additionalProperties": {
        "type": "object",
        "required": [
          "char",
          "finger",
          "row"
        ],
        "properties": {
          "char": {
            "type": "string"
          },
          "shift": {
            "type": "string"
          },
          "finger": {
            "enum": [
              "lp",
              "lr",
              "lm",
              "li",
              "lt",
              "rt",
              "ri",
              "rm",
              "rr",
              "rp"
            ]
          },
          "row": {
            "enum": [
              "number",
              "top",
              "home",
              "bottom",
              "space"
            ]
          },
          "homeBump": {
            "type": "boolean"
          }
        }
      }
    },
    "order": {
      "type": "array",
      "description": "Levels: each entry lists keys introduced",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "minItems": 1
    },
    "orderVariants": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "keyGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "keys"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        }
      }
    },
    "words": {
      "type": "object",
      "description": "tag -> relative path of word list",
      "additionalProperties": {
        "type": "string"
      }
    },
    "blocklist": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tts": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string"
        },
        "preferredVoices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "wordEmoji": {
      "type": "object",
      "description": "word -> emoji shown when a word has no illustration",
      "additionalProperties": {
        "type": "string"
      }
    },
    "breakNudges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Supportive phrases shown when the player tries to end a stretch break early"
    },
    "stretchSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "move",
          "text"
        ],
        "properties": {
          "move": {
            "enum": [
              "shake",
              "roll",
              "reach",
              "look",
              "wiggle",
              "breathe"
            ]
          },
          "icon": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "alphabet",
    "layout",
    "order",
    "keyGroups",
    "words",
    "blocklist"
  ]
}
