{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life2do.github.io/the-best-typing-game-ever/schemas/profile.schema.json",
  "title": "Player profile (local save)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "profileId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "pin": {
      "type": [
        "string",
        "null"
      ],
      "description": "salted hash of 4-digit PIN"
    },
    "avatar": {
      "type": "object",
      "required": [
        "scale"
      ],
      "properties": {
        "scale": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "customization": {
          "type": "object"
        }
      }
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "tierHistory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "starsByTier": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "seed"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "seed": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "stage": {
            "type": "integer"
          },
          "fingerprint": {
            "$ref": "common.schema.json#/$defs/hash"
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "properties": {
        "abilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "revealed": {
          "type": "object"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "avatar",
    "tier"
  ]
}
